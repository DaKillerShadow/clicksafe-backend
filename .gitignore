# =============================================================================
# backend/.gitignore
# =============================================================================
# SECURITY: .env contains live API keys (INTEL_API_KEY, GOOGLE_SAFE_BROWSING_KEY).
# It must NEVER be committed.  Only .env.example (with placeholder values) is
# tracked.  Rotate any key that was committed before this file was in place.
# =============================================================================

# ── Secrets & local config (NEVER commit) ─────────────────────────────────────
.env
*.env
.env.*
!.env.example          # .env.example IS tracked — it has no real values

# ── Python byte-code & caches ─────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
.pytest_cache/
.mypy_cache/

# ── Virtual environments ───────────────────────────────────────────────────────
venv/
.venv/
env/
ENV/

